# Zenlock Backend Environment Variables
# Copy this file to .env locally: cp .env.example .env

PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/zenlock?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
